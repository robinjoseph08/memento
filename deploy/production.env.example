# Copy this file outside the source checkout, replace every placeholder, and
# protect it with mode 0600. Copy only the sha256 digest from the release's
# memento-image.txt. The Compose file fixes the registry and repository.
MEMENTO_IMAGE_DIGEST=sha256:<release-digest>
MEMENTO_CONFIG_PATH=/srv/memento/config/memento.yaml
MEMENTO_SECRETS_PATH=/srv/memento/secrets
MEMENTO_NETWORK=immich_default

# Bind to loopback when a host reverse proxy fronts Memento. Change deliberately
# only when the bundled Caddy endpoint should be reachable on another address.
# MEMENTO_BIND_ADDRESS=127.0.0.1
# MEMENTO_PORT=8080
# MEMENTO_SITE_ADDRESS=:8080

# Set this to the CIDRs of a separate trusted reverse proxy, if one is used.
# MEMENTO_CADDY_TRUSTED_PROXY_CIDRS=127.0.0.0/8 ::1/128

# Optional secret files are paths inside /run/secrets. Leave them unset when the
# corresponding feature is disabled. A Recovery nonce is only for the first
# start after a validated restore and must be removed immediately afterward.
# MEMENTO_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# MEMENTO_PUSH_PRIVATE_KEY_FILE=/run/secrets/push_private_key
# MEMENTO_RECOVERY_NONCE_FILE=/run/secrets/recovery_nonce
